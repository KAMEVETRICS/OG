# Network writes remain disabled unless these values are explicitly configured.
OG_RPC_URL=https://evmrpc.0g.ai
OG_STORAGE_INDEXER_RPC=https://indexer-storage-turbo.0g.ai
OG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
OG_COMPUTE_API_KEY=
OG_COMPUTE_MODEL=zai-org/GLM-5-FP8
OG_PRIVATE_KEY=

# Public certifier safeguards. Secrets stay server-side; never expose these to browser code.
CERTIFIER_DAILY_OWNER_LIMIT=2
CERTIFIER_DAILY_GLOBAL_LIMIT=20
SITE_ORIGIN=http://localhost:3000

# Required for /certify. Inspect and GET /v1 work without it.
# Vercel → Storage → Create Database → Neon injects DATABASE_URL.
DATABASE_URL=

# Official ERC-8004 deployments on 0G mainnet (chain ID 16661).
ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ERC8004_REPUTATION_REGISTRY=0x8004BAa17C55a88189AE136b182e5fdA19dE9b63
